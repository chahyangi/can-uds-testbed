FROM ubuntu:24.04

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
      can-utils iproute2 pipx python3 && \
    rm -rf /var/lib/apt/lists/* && \
    pipx install gallia==2.1.1
ENV PATH="/root/.local/bin:${PATH}"
WORKDIR /testbed
COPY scripts/run_gallia_vecu.sh /usr/local/bin/run-gallia-vecu
RUN chmod +x /usr/local/bin/run-gallia-vecu
ENTRYPOINT ["run-gallia-vecu"]
